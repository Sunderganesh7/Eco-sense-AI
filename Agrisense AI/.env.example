# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fasalai
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret for authentication tokens
JWT_SECRET=your_secure_random_jwt_secret_key_here

# External APIs (Optional - system falls back to free Open-Meteo & keyless IP geolocation)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
IPSTACK_API_KEY=your_ipstack_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=alerts@yourdomain.com
BREVO_SENDER_NAME=Fasal.AI Advisory
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=centralindia

# Optional Google OAuth via Supabase (Local auth works without this)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
