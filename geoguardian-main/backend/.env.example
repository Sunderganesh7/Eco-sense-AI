# GeoGuardian Environment Configuration
# Set DEMO_MODE=true to run the server on Render Free without MySQL or Sentinel credentials
DEMO_MODE=true

# Server
PORT=5000
NODE_ENV=development

# MySQL (Optional in DEMO_MODE=true; required when DEMO_MODE=false)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geoguardian
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# Copernicus Sentinel Hub API (Optional in DEMO_MODE=true)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Gemini AI reports (optional unless using /api/analysis/ai-report)
GEMINI_API_KEY=your-gemini-api-key

# Email Alerts (Gmail - optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key
