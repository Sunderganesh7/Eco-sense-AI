# ============================================================
# GreenPath AI — Environment Variables Template
# Copy this to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="GreenPath AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- JWT Auth ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=greenpath_ai

# --- Google Gemini AI (for chatbot) ---
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- File Storage ---
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_FILE_SIZE_MB=20

# --- YOLO Model ---
YOLO_MODEL_PATH=models/best.pt
YOLO_CONFIDENCE=0.25

# --- Sentinel Hub (Optional — for real satellite NDVI) ---
# Leave blank to use local NDVI from uploaded images
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Admin User (auto-created on startup) ---
ADMIN_EMAIL=admin@greenpath.ai
ADMIN_PASSWORD=Admin@GreenPath2024
ADMIN_NAME=System Admin
