# ============================================================
# GreenPath AI — Environment Configuration Example (.env.example)
# Copy this file to .env and adjust credentials as needed.
# ============================================================

# --- Application Server ---
APP_NAME=GreenPath AI
APP_ENV=development
APP_PORT=5000
DEBUG=True
SECRET_KEY=greenpath-enterprise-secret-key-replace-in-production-2026
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=greenpath_ai
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=5

# --- JWT Security Tokens ---
JWT_SECRET_KEY=greenpath-jwt-super-secret-key-replace-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password Reset OTP Configuration ---
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# --- Security & CORS ---
CORS_HEADERS=Content-Type,Authorization
MAX_CONTENT_LENGTH_MB=10
