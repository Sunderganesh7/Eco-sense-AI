"""
GreenPath AI — Hybrid Datastore (MongoDB Atlas + SQLite Fallback)
Provides premium enterprise storage utilizing MongoDB Atlas as the primary database
with dual-write local SQLite replication for 100% offline fault-tolerant availability.
"""

import sqlite3
import os
import pymongo
import logging
import random
from datetime import datetime
from werkzeug.security import generate_password_hash, check_password_hash

logger = logging.getLogger("greenpath.database")
DATABASE_PATH = "greenpath.db"

# ================================================================
# MONGODB CONNECTION MANAGER
# ================================================================
mongo_client = None
mongo_db = None
mongodb_url = "mongodb://localhost:27017"
mongodb_db_name = "greenpath_ai"

# Attempt to load MongoDB credentials from system settings
try:
    from backend.config import settings
    mongodb_url = settings.MONGODB_URL
    mongodb_db_name = settings.MONGODB_DB_NAME
except Exception:
    pass

# Read directly from environment if settings are missing
mongodb_url = os.environ.get("MONGODB_URL") or mongodb_url
mongodb_db_name = os.environ.get("MONGODB_DB_NAME") or mongodb_db_name

try:
    if mongodb_url:
        logger.info(f"Connecting to MongoDB Atlas at {mongodb_url[:25]}...")
        mongo_client = pymongo.MongoClient(mongodb_url, serverSelectionTimeoutMS=3000)
        # Force a connection handshake / ping test
        mongo_client.admin.command('ping')
        mongo_db = mongo_client[mongodb_db_name]
        logger.info(f"🟢 Successfully connected to MongoDB database: {mongodb_db_name}")
except Exception as e:
    mongo_client = None
    mongo_db = None
    logger.warning(f"🔴 MongoDB Atlas connection failed ({e}). Falling back to local SQLite database.")

def is_db_connected():
    """Returns True if the primary MongoDB database is connected."""
    if mongo_db is None:
        return False
    try:
        mongo_client.admin.command('ping')
        return True
    except Exception:
        return False

# ================================================================
# SQLITE PORTABLE COMPATIBILITY
# ================================================================
def get_db_connection():
    """Establish a connection to the local SQLite database."""
    conn = sqlite3.connect(DATABASE_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    """Initialize database tables and run migrations if tables do not exist."""
    conn = get_db_connection()
    cursor = conn.cursor()
    
    # 1. Users Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL,
        email TEXT UNIQUE NOT NULL,
        password TEXT NOT NULL,
        created_at TEXT NOT NULL
    );
    """)
    
    # 2. Analyses Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS analyses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        filename TEXT NOT NULL,
        tree_count INTEGER NOT NULL,
        green_percent REAL NOT NULL,
        co2_absorption REAL NOT NULL,
        eco_index INTEGER NOT NULL,
        aqi_result TEXT NOT NULL,
        created_at TEXT NOT NULL,
        FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """)
    
    # 3. Reports Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS reports (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        analysis_id INTEGER,
        title TEXT NOT NULL,
        filename TEXT NOT NULL,
        created_at TEXT NOT NULL,
        FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE,
        FOREIGN KEY(analysis_id) REFERENCES analyses(id) ON DELETE CASCADE
    );
    """)
    
    conn.commit()
    conn.close()

# ================================================================
# USER AUTHENTICATION QUERIES
# ================================================================
def register_user(name, email, password):
    """
    Registers a new user securely with password hashing.
    Supports MongoDB Atlas writes with transparent SQLite sync replication.
    """
    init_db()
    hashed_pwd = generate_password_hash(password)
    created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    random_id = random.randint(100000, 999999)

    # 1. Try Primary MongoDB Atlas First
    if is_db_connected():
        try:
            users_col = mongo_db["users"]
            existing = users_col.find_one({"email": email})
            if existing:
                return False, "An account with this email address already exists.", None

            user_doc = {
                "id": random_id,
                "name": name,
                "email": email,
                "password": hashed_pwd,
                "created_at": created_at
            }
            users_col.insert_one(user_doc)

            # Replicate write to SQLite local cache
            try:
                conn = get_db_connection()
                cursor = conn.cursor()
                cursor.execute(
                    "INSERT INTO users (id, name, email, password, created_at) VALUES (?, ?, ?, ?, ?)",
                    (random_id, name, email, hashed_pwd, created_at)
                )
                conn.commit()
                conn.close()
            except Exception as se:
                logger.warning(f"Failed SQLite registration sync: {se}")

            user_ret = user_doc.copy()
            user_ret.pop("password", None)
            return True, "Registration successful!", user_ret
        except Exception as e:
            logger.warning(f"MongoDB write failed during registration: {e}. Falling back to SQLite.")

    # 2. Fallback / Offline local SQLite execution
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM users WHERE email = ?", (email,))
    if cursor.fetchone():
        conn.close()
        return False, "An account with this email address already exists.", None

    try:
        cursor.execute(
            "INSERT INTO users (id, name, email, password, created_at) VALUES (?, ?, ?, ?, ?)",
            (random_id, name, email, hashed_pwd, created_at)
        )
        conn.commit()
        conn.close()

        user = {
            "id": random_id,
            "name": name,
            "email": email,
            "created_at": created_at
        }
        return True, "Registration successful!", user
    except Exception as e:
        conn.close()
        return False, f"Database error: {str(e)}", None

def authenticate_user(email, password):
    """Verifies user credentials from MongoDB Atlas, falling back to SQLite."""
    init_db()

    # 1. Try Primary MongoDB Atlas First
    if is_db_connected():
        try:
            users_col = mongo_db["users"]
            row = users_col.find_one({"email": email})
            if row:
                if check_password_hash(row["password"], password):
                    user = dict(row)
                    user.pop("_id", None)
                    user.pop("password", None)
                    return True, "Authentication successful!", user
                else:
                    return False, "Invalid email address or password.", None
        except Exception as e:
            logger.warning(f"MongoDB auth failed: {e}. Checking local cache.")

    # 2. Fallback to Local SQLite Cache
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM users WHERE email = ?", (email,))
    row = cursor.fetchone()
    conn.close()

    if not row:
        return False, "Invalid email address or password.", None

    user = dict(row)
    if check_password_hash(user["password"], password):
        user.pop("password", None)
        return True, "Authentication successful!", user
    else:
        return False, "Invalid email address or password.", None

# ================================================================
# ANALYSIS LOGGING QUERIES
# ================================================================
def log_analysis(user_id, filename, tree_count, green_percent, co2_absorption, eco_index, aqi_result):
    """Log an analysis run inside MongoDB Atlas with local SQLite replication."""
    created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    analysis_id = None
    random_id = random.randint(100000, 999999)

    # 1. MongoDB Primary Write
    if is_db_connected():
        try:
            analyses_col = mongo_db["analyses"]
            doc = {
                "id": random_id,
                "user_id": int(user_id) if user_id else None,
                "filename": filename,
                "tree_count": int(tree_count),
                "green_percent": float(green_percent),
                "co2_absorption": float(co2_absorption),
                "eco_index": int(eco_index),
                "aqi_result": aqi_result,
                "created_at": created_at
            }
            analyses_col.insert_one(doc)
            analysis_id = random_id
        except Exception as e:
            logger.warning(f"MongoDB analysis logging failed: {e}")

    # 2. SQLite local write replication
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
        INSERT INTO analyses (user_id, filename, tree_count, green_percent, co2_absorption, eco_index, aqi_result, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (user_id, filename, tree_count, green_percent, co2_absorption, eco_index, aqi_result, created_at))
        sqlite_id = cursor.lastrowid
        conn.commit()
        conn.close()
        
        if not analysis_id:
            analysis_id = sqlite_id
    except Exception as e:
        logger.warning(f"SQLite local backup write failed: {e}")

    return analysis_id or 1

def get_user_analyses(user_id):
    """Fetch all historical analysis runs for a specific user, sorted by date descending."""
    # 1. Try Primary MongoDB
    if is_db_connected():
        try:
            analyses_col = mongo_db["analyses"]
            rows = list(analyses_col.find({"user_id": int(user_id)}).sort("created_at", pymongo.DESCENDING))
            for r in rows:
                r.pop("_id", None)
            return rows
        except Exception as e:
            logger.warning(f"MongoDB read analyses failed: {e}. Reading from local SQLite cache.")

    # 2. SQLite local read
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM analyses WHERE user_id = ? ORDER BY id DESC", (user_id,))
    rows = cursor.fetchall()
    conn.close()
    return [dict(row) for row in rows]

# ================================================================
# REPORT LOGGING QUERIES
# ================================================================
def log_report(user_id, analysis_id, title, filename):
    """Archives a generated PDF report into MongoDB and SQLite."""
    created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    report_id = None
    random_id = random.randint(100000, 999999)

    # 1. MongoDB primary archive
    if is_db_connected():
        try:
            reports_col = mongo_db["reports"]
            doc = {
                "id": random_id,
                "user_id": int(user_id) if user_id else None,
                "analysis_id": int(analysis_id) if analysis_id else None,
                "title": title,
                "filename": filename,
                "created_at": created_at
            }
            reports_col.insert_one(doc)
            report_id = random_id
        except Exception as e:
            logger.warning(f"MongoDB report archiving failed: {e}")

    # 2. SQLite local replication
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("""
        INSERT INTO reports (user_id, analysis_id, title, filename, created_at)
        VALUES (?, ?, ?, ?, ?)
        """, (user_id, analysis_id, title, filename, created_at))
        sqlite_id = cursor.lastrowid
        conn.commit()
        conn.close()
        
        if not report_id:
            report_id = sqlite_id
    except Exception as e:
        logger.warning(f"SQLite report backup archiving failed: {e}")

    return report_id or 1

def get_user_reports(user_id):
    """Fetch all archived PDF reports for a user."""
    # 1. Try Primary MongoDB
    if is_db_connected():
        try:
            reports_col = mongo_db["reports"]
            rows = list(reports_col.find({"user_id": int(user_id)}).sort("created_at", pymongo.DESCENDING))
            for r in rows:
                r.pop("_id", None)
            return rows
        except Exception as e:
            logger.warning(f"MongoDB read reports failed: {e}. Checking local cache.")

    # 2. SQLite fallback read
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM reports WHERE user_id = ? ORDER BY id DESC", (user_id,))
    rows = cursor.fetchall()
    conn.close()
    return [dict(row) for row in rows]

def get_global_stats():
    """Computes administrative dashboard global telemetry counts using MongoDB or SQLite."""
    init_db()

    # 1. MongoDB Aggregation
    if is_db_connected():
        try:
            stats = {}
            stats["total_users"] = mongo_db["users"].count_documents({})
            stats["total_reports"] = mongo_db["reports"].count_documents({})
            
            analyses_col = mongo_db["analyses"]
            pipeline = [
                {
                    "$group": {
                        "_id": None,
                        "total_count": {"$sum": 1},
                        "total_trees": {"$sum": "$tree_count"},
                        "avg_green": {"$avg": "$green_percent"},
                        "total_co2": {"$sum": "$co2_absorption"}
                    }
                }
            ]
            agg = list(analyses_col.aggregate(pipeline))
            if agg:
                stats["total_analyses"] = agg[0]["total_count"] or 0
                stats["total_trees_detected"] = agg[0]["total_trees"] or 0
                stats["avg_green_cover"] = round(agg[0]["avg_green"], 1) if agg[0]["avg_green"] else 0.0
                stats["total_co2_absorbed_kg"] = round(agg[0]["total_co2"], 1) if agg[0]["total_co2"] else 0.0
            else:
                stats["total_analyses"] = 0
                stats["total_trees_detected"] = 0
                stats["avg_green_cover"] = 0.0
                stats["total_co2_absorbed_kg"] = 0.0

            # 5 Recent Analyses
            recent = list(analyses_col.find().sort("created_at", pymongo.DESCENDING).limit(5))
            recent_list = []
            for r in recent:
                r.pop("_id", None)
                uid = r.get("user_id")
                uname = "Academic Guest"
                if uid:
                    user_doc = mongo_db["users"].find_one({"id": uid})
                    if user_doc:
                        uname = user_doc.get("name", "Academic Guest")
                r["user_name"] = uname
                recent_list.append(r)
            stats["recent_analyses"] = recent_list
            return stats
        except Exception as e:
            logger.warning(f"MongoDB global stats aggregation failed: {e}. Using SQLite.")

    # 2. SQLite local statistics calculation
    conn = get_db_connection()
    cursor = conn.cursor()
    
    stats = {}
    cursor.execute("SELECT COUNT(*) FROM users")
    stats["total_users"] = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(*), SUM(tree_count), AVG(green_percent), SUM(co2_absorption) FROM analyses")
    row = cursor.fetchone()
    
    stats["total_analyses"] = row[0] or 0
    stats["total_trees_detected"] = row[1] or 0
    stats["avg_green_cover"] = round(row[2], 1) if row[2] else 0.0
    stats["total_co2_absorbed_kg"] = row[3] or 0
    
    cursor.execute("SELECT COUNT(*) FROM reports")
    stats["total_reports"] = cursor.fetchone()[0]
    
    cursor.execute("""
    SELECT a.*, u.name as user_name 
    FROM analyses a 
    LEFT JOIN users u ON a.user_id = u.id 
    ORDER BY a.id DESC LIMIT 5
    """)
    stats["recent_analyses"] = [dict(r) for r in cursor.fetchall()]
    
    conn.close()
    return stats
