@app.route("/download-report")
@login_required
def download_report():
    if "current_image" not in session:
        return redirect(url_for("home"))
        
    try:
        from backend.services.report_service import generate_environmental_report
        import datetime
        import math
        
        # Build analysis dictionary matching report requirements
        analysis_data = {
            "tree_count": session.get("tree_count", 0),
            "green_cover_percent": session.get("green", 0.0),
            "aqi_score": session.get("aqi_score", 50),
            "aqi_category": session.get("aqi_category", "Good"),
            "eco_index": session.get("eco_index", 50),
            "co2_absorption_kg": session.get("co2_absorption", 0.0),
            "heat_reduction_celsius": session.get("heat_reduction", 0.0),
            "cooling_level": session.get("cooling_level", "Moderate"),
            "tree_health_summary": session.get("health_summary", {}),
            "ndvi_mean": round(session.get("green", 0.0) / 100.0 * 0.7 + 0.1, 3)
        }
        
        # Build predictions dict matching report specs
        pred_data = {
            "months": ["Month 1", "Month 2", "Month 3", "Month 4", "Month 5", "Month 6", "Month 7", "Month 8", "Month 9", "Month 10", "Month 11", "Month 12"],
            "predicted_aqi": [session.get("aqi_score", 50) + math.sin(i)*8 for i in range(12)],
            "predicted_carbon_kg": [session.get("co2_absorption", 0.0) * (1.0 + (i*0.025)) for i in range(12)],
            "insights": [
                "Carbon sequestration projected to grow 2.5% over next quarter.",
                "Visual air quality index expected to improve under microclimatic growth.",
                "Afforestation priority remains high in the critical zones mapped."
            ]
        }
        
        # Build recommendations dict matching report specs
        rec_data = {
            "urgency": "High" if session.get("eco_index", 50) < 50 else "Moderate",
            "trees_needed": max(15, 60 - int(session.get("tree_count", 0))),
            "priority_zones": [z.replace(" Zone", "") for z, val in session.get("zones", {}).items() if "Critical" in val or "Heat Risk" in val],
            "recommended_species": [
                {"name": "Neem (Azadirachta indica)", "co2_absorption_kg_year": 30, "heat_reduction": "High", "growth_speed": "Fast"},
                {"name": "Banyan (Ficus benghalensis)", "co2_absorption_kg_year": 45, "heat_reduction": "High", "growth_speed": "Slow"},
                {"name": "Peepal (Ficus religiosa)", "co2_absorption_kg_year": 40, "heat_reduction": "High", "growth_speed": "Medium"}
            ],
            "action_plan": [
                "1. Plant mature broadleaf canopies in the critical quadrants mapped.",
                "2. Implement moisture-retention layers around newly planted saplings.",
                "3. Monitor dry/diseased tree segments for rapid revitalization treatments."
            ]
        }
        
        # Generate the PDF report
        pdf_path = generate_environmental_report(
            analysis=analysis_data,
            predictions=pred_data,
            recommendations=rec_data,
            output_dir=OUTPUT_FOLDER,
            report_title="GreenPath AI Environmental Audit"
        )
        
        # Log report history in SQLite
        from backend.database.sqlite_db import log_report
        user_id = session.get("user", {}).get("id")
        from backend.database.sqlite_db import get_user_analyses
        analyses = get_user_analyses(user_id)
        analysis_id = analyses[0]["id"] if analyses else None
        if user_id and analysis_id:
            try:
                log_report(
                    user_id=user_id,
                    analysis_id=analysis_id,
                    title="Executive Environmental Audit Report",
                    filename=os.path.basename(pdf_path)
                )
            except Exception:
                pass
                
        # Send PDF file to user
        from flask import send_file
        return send_file(pdf_path, as_attachment=True, download_name=os.path.basename(pdf_path))
    except Exception as e:
        import traceback
        traceback.print_exc()
        flash(f"Failed to generate PDF report: {str(e)}", "error")
        return redirect(url_for("home"))


