@app.route("/drone")
@login_required
def drone():
    return render_template("index.html", **get_dashboard_context("drone"))


@app.route("/api/drone/telemetry", methods=["GET"])
@login_required
def drone_telemetry():
    from backend.services.drone_service import DroneService
    service = DroneService.get_instance()
    return service.get_telemetry_data()


@app.route("/api/drone/control", methods=["POST"])
@login_required
def drone_control():
    from backend.services.drone_service import DroneService
    service = DroneService.get_instance()
    
    data = request.get_json()
    if not data:
        return {"success": False, "message": "No data provided"}, 400
        
    action = data.get("action")
    if action == "start":
        service.start_mission()
    elif action == "pause":
        service.pause_mission()
    elif action == "rtl":
        service.trigger_rtl()
    elif action == "reset":
        service.reset_mission()
    elif action == "record_toggle":
        new_status = service.toggle_camera_record()
        return {"success": True, "camera_status": new_status}
    else:
        return {"success": False, "message": f"Unknown action: {action}"}, 400
        
    return {"success": True}


