{
  "name": "eco-sense-ai",
  "version": "1.0.0",
  "description": "Eco Sense AI Unified Launcher",
  "scripts": {
    "dev": "node start.js",
    "dev:dashboard": "vite",
    "dev:carbonwise": "cd carbonwise-ai-main && npm run dev",
    "dev:geoguardian": "cd geoguardian-main && npm run dev",
    "dev:ecomind": "concurrently \"npm run dev:ecomind:backend\" \"npm run dev:ecomind:frontend\"",
    "dev:ecomind:backend": "cd \"ECO MIND AI/backend\" && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8001",
    "dev:ecomind:frontend": "cd \"ECO MIND AI/frontend\" && npm run dev",
    "dev:plantwise": "concurrently \"npm run dev:plantwise:backend\" \"npm run dev:plantwise:frontend\"",
    "dev:plantwise:backend": "cd \"Plantwise AI/backend\" && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8002",
    "dev:plantwise:frontend": "cd \"Plantwise AI/frontend\" && npm run dev",
    "dev:greenpath": "cd \"GreenPath AI/GreenPath AI\" && .venv\\Scripts\\python.exe app.py",
    "dev:agrisense": "concurrently \"npm run dev:agrisense:backend\" \"npm run dev:agrisense:frontend\"",
    "dev:agrisense:backend": "cd \"Agrisense AI/api\" && ..\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8003",
    "dev:agrisense:frontend": "cd \"Agrisense AI/apps/web\" && npm run dev",
    "build": "vite build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^8.3.1"
  }
}